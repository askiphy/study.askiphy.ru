---
import {getCollection} from "astro:content";
import BlogCard from "./BlogCard.astro";
import AltCard from "./AltCard.astro";

interface Props {
    showHidden: boolean;
}

const { showHidden } = Astro.props;

let posts = (await getCollection('blog'));

if (!showHidden) {
    posts = posts.filter((post) => !post.data.isHidden);
}

const courses = Object.fromEntries(
    Map.groupBy(posts, (post) => post.data.course),
);
---

<section>
    {
        Object.keys(courses).map((course) => (
                <>
                    <div class="text-block">
                        <h1 class="text-blue-50 text-2xl text-center m-8 underline">{course}</h1>
                        <ul class="">
                            {courses[course].map((post) => <AltCard name={post.data.title} pubDate={post.data.pubDate}  description="" href=`/blog/${post.id}`/>)}
                        </ul>
                    </div>
                </>
        ))
    }
</section>